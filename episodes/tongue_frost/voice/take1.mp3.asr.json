[{"start": 0.0, "end": 3.58, "text": "Что если язык прилип к качелям на морозе?", "words": [["Что", 0.0, 0.24], ["если", 0.24, 0.68], ["язык", 0.68, 1.26], ["прилип", 1.26, 1.66], ["к", 1.66, 1.86], ["качелям", 1.86, 2.44], ["на", 2.44, 2.66], ["морозе?", 2.66, 3.58]]}, {"start": 3.72, "end": 4.44, "text": "Правда.", "words": [["Правда.", 3.72, 4.44]]}, {"start": 4.54, "end": 6.2, "text": "Минус тысяча ауры.", "words": [["Минус", 4.54, 5.06], ["тысяча", 5.06, 5.82], ["ауры.", 5.82, 6.2]]}, {"start": 6.7, "end": 7.14, "text": "Стоп.", "words": [["Стоп.", 6.7, 7.14]]}, {"start": 7.3, "end": 8.06, "text": "Не дёргай.", "words": [["Не", 7.3, 7.52], ["дёргай.", 7.52, 8.06]]}, {"start": 8.34, "end": 10.56, "text": "Учёные проверили на свиных языках.", "words": [["Учёные", 8.34, 8.78], ["проверили", 8.78, 9.3], ["на", 9.3, 9.5], ["свиных", 9.5, 9.98], ["языках.", 9.98, 10.56]]}, {"start": 10.68, "end": 14.22, "text": "Рывок рвал их в 54% опытов.", "words": [["Рывок", 10.68, 11.18], ["рвал", 11.18, 11.52], ["их", 11.52, 11.66], ["в", 11.66, 11.8], ["54", 11.8, 12.56], ["%", 12.56, 13.3], ["опытов.", 13.3, 14.22]]}, {"start": 14.44, "end": 17.68, "text": "Металл мигом забирает тепло и слюна замерзает.", "words": [["Металл", 14.44, 14.94], ["мигом", 14.94, 15.24], ["забирает", 15.24, 15.72], ["тепло", 15.72, 16.24], ["и", 16.24, 16.56], ["слюна", 16.56, 16.98], ["замерзает.", 16.98, 17.68]]}, {"start": 18.04, "end": 22.24, "text": "Хуже всего не минус 30, а от минус 5 до минус 15.", "words": [["Хуже", 18.04, 18.36], ["всего", 18.36, 18.76], ["не", 18.76, 18.98], ["минус", 18.98, 19.46], ["30,", 19.46, 19.84], ["а", 19.88, 20.12], ["от", 20.12, 20.28], ["минус", 20.28, 20.66], ["5", 20.66, 20.96], ["до", 20.96, 21.16], ["минус", 21.16, 21.58], ["15.", 21.58, 22.24]]}, {"start": 22.58, "end": 23.88, "text": "Сегодня минус 10.", "words": [["Сегодня", 22.58, 23.02], ["минус", 23.02, 23.48], ["10.", 23.48, 23.88]]}, {"start": 24.16, "end": 25.38, "text": "Полей тёплой водой.", "words": [["Полей", 24.16, 24.52], ["тёплой", 24.52, 24.98], ["водой.", 24.98, 25.38]]}, {"start": 25.68, "end": 26.52, "text": "Не кипятком.", "words": [["Не", 25.68, 25.9], ["кипятком.", 25.9, 26.52]]}, {"start": 26.9, "end": 29.1, "text": "Воды нет – подыши на металл.", "words": [["Воды", 26.9, 27.22], ["нет", 27.22, 27.58], ["–", 27.58, 27.86], ["подыши", 27.86, 28.3], ["на", 28.3, 28.46], ["металл.", 28.46, 29.1]]}, {"start": 29.1, "end": 29.86, "text": "Медленно.", "words": [["Медленно.", 29.1, 29.86]]}, {"start": 30.14, "end": 31.28, "text": "Лёд отпустит сам.", "words": [["Лёд", 30.14, 30.4], ["отпустит", 30.4, 30.98], ["сам.", 30.98, 31.28]]}, {"start": 31.9, "end": 33.96, "text": "Плюс 500 ауры за спокойствие.", "words": [["Плюс", 31.9, 32.32], ["500", 32.32, 32.56], ["ауры", 32.56, 32.98], ["за", 32.98, 33.2], ["спокойствие.", 33.2, 33.96]]}, {"start": 34.34, "end": 36.48, "text": "Дома пропалащи рот тёплой водой.", "words": [["Дома", 34.34, 34.74], ["пропалащи", 34.74, 35.32], ["рот", 35.32, 35.54], ["тёплой", 35.54, 36.02], ["водой.", 36.02, 36.48]]}, {"start": 36.84, "end": 39.82, "text": "Сутки без горячего, кислого и острого.", "words": [["Сутки", 36.84, 37.5], ["без", 37.5, 37.78], ["горячего,", 37.78, 38.4], ["кислого", 38.6, 39.0], ["и", 39.0, 39.36], ["острого.", 39.36, 39.82]]}, {"start": 40.2, "end": 44.18, "text": "К врачу, если сильно болит, опух, кровит, трудно есть", "words": [["К", 40.2, 40.38], ["врачу,", 40.38, 40.86], ["если", 40.86, 41.2], ["сильно", 41.2, 41.54], ["болит,", 41.54, 42.12], ["опух,", 42.34, 42.68], ["кровит,", 42.86, 43.36], ["трудно", 43.62, 43.94], ["есть", 43.94, 44.18]]}, {"start": 44.18, "end": 44.82, "text": "или говорить.", "words": [["или", 44.18, 44.38], ["говорить.", 44.38, 44.82]]}, {"start": 45.24, "end": 47.58, "text": "Сохрани и пусть не пригодится.", "words": [["Сохрани", 45.24, 45.94], ["и", 45.94, 46.32], ["пусть", 46.32, 46.74], ["не", 46.74, 47.04], ["пригодится.", 47.04, 47.58]]}]