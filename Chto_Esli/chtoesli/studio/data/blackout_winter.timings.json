[
 {
  "id": "s01",
  "line": "Минус двадцать. Во всём доме погас свет.",
  "start": 0.0,
  "dur": 3.87,
  "voice": 3.52,
  "file": "voice/s01-6169f31683.m1.2.wav"
 },
 {
  "id": "s02",
  "line": "Холодильник не открывай.",
  "start": 3.87,
  "dur": 2.0,
  "voice": 1.605,
  "file": "voice/s02-e1292bd84a.m1.2.wav"
 },
 {
  "id": "s03",
  "line": "Закрытый держит холод четыре часа.",
  "start": 5.87,
  "dur": 2.599,
  "voice": 2.249,
  "file": "voice/s03-532dfb69b0.m1.2.wav"
 },
 {
  "id": "s04",
  "line": "Полная морозилка — двое суток.",
  "start": 8.469,
  "dur": 2.458,
  "voice": 2.108,
  "file": "voice/s04-d81a73264f.m1.2.wav"
 },
 {
  "id": "s05",
  "line": "Технику выдерни из розеток.",
  "start": 10.927,
  "dur": 2.287,
  "voice": 1.937,
  "file": "voice/s05-2141ea127e.m1.2.wav"
 },
 {
  "id": "s06",
  "line": "Свет вернётся скачком, и она может сгореть.",
  "start": 13.214,
  "dur": 3.15,
  "voice": 2.8,
  "file": "voice/s06-c4450bfc11.m1.2.wav"
 },
 {
  "id": "s07",
  "line": "Одну лампу оставь включённой: так поймёшь, что свет дали.",
  "start": 16.364,
  "dur": 3.778,
  "voice": 3.428,
  "file": "voice/s07-081a29a180.m1.2.wav"
 },
 {
  "id": "s08",
  "line": "Газовой плитой не греться.",
  "start": 20.142,
  "dur": 2.088,
  "voice": 1.738,
  "file": "voice/s08-c33e3986c6.m1.2.wav"
 },
 {
  "id": "s09",
  "line": "Угарный газ без цвета и запаха. Во сне можно не проснуться.",
  "start": 22.23,
  "dur": 4.805,
  "voice": 4.455,
  "file": "voice/s09-482ddd6af8.m1.2.wav"
 },
 {
  "id": "s10",
  "line": "Все в одну комнату, остальные двери закрыть.",
  "start": 27.035,
  "dur": 3.011,
  "voice": 2.661,
  "file": "voice/s10-2f87055d9c.m1.2.wav"
 },
 {
  "id": "s11",
  "line": "Щель под дверью заткни полотенцем.",
  "start": 30.046,
  "dur": 2.486,
  "voice": 2.136,
  "file": "voice/s11-129e813bcf.m1.2.wav"
 },
 {
  "id": "s12",
  "line": "Набери воды, пока она идёт.",
  "start": 32.532,
  "dur": 2.328,
  "voice": 1.978,
  "file": "voice/s12-facc412217.m1.2.wav"
 },
 {
  "id": "s13",
  "line": "Насосы тоже без света, и наверх вода не дойдёт.",
  "start": 34.86,
  "dur": 3.4,
  "voice": 3.05,
  "file": "voice/s13-df9399fca2.m1.2.wav"
 },
 {
  "id": "s14",
  "line": "Сохрани, пока свет есть.",
  "start": 38.26,
  "dur": 2.362,
  "voice": 2.012,
  "file": "voice/s14-963bbf6066.m1.2.wav"
 }
]